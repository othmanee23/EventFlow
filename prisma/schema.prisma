generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  LEADER
  MEMBER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ON_HOLD
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskCategory {
  EVENT_PREPARATION
  PARTICIPANTS
  COMMUNICATION
  LOGISTICS
  AUDIOVISUAL_PRODUCTION
  POST_EVENT
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique
  passwordHash       String
  role               UserRole
  department         String
  avatarUrl          String?
  ledProjects        Project[]       @relation("ProjectLeader")
  projectMemberships ProjectMember[]
  assignedTasks      TaskAssignment[] @relation("TaskAssignee")
  comments           Comment[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Project {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  status      ProjectStatus   @default(PLANNING)
  startDate   DateTime
  endDate     DateTime
  leaderId    String
  leader      User            @relation("ProjectLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  tasks       Task[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([leaderId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model ProjectMember {
  projectId  String
  userId     String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String
  category    TaskCategory
  status      TaskStatus      @default(TODO)
  priority    TaskPriority    @default(MEDIUM)
  dueDate     DateTime
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments TaskAssignment[]
  checklist   ChecklistItem[]
  comments    Comment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, status])
  @@index([category])
  @@index([dueDate])
}

model TaskAssignment {
  taskId      String
  userId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation("TaskAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  taskId      String
  label       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([authorId])
}
